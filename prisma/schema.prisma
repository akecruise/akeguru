// akeguru — Prisma schema
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Market {
  TH
  US
  HK
}

enum PeriodType {
  ANNUAL
  QUARTERLY
}

enum RefreshStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String          @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  createdAt      DateTime        @default(now())
  watchlistItems WatchlistItem[]
  notes          Note[]
  deepReports    DeepReport[]
}

model Stock {
  id       String  @id @default(cuid())
  ticker   String  @unique
  market   Market
  exchange String
  name     String
  sector   String?
  industry String?
  currency String? // defaulted from `market` at ingestion time (TH -> THB, US -> USD); should never be null in practice
  description String? @db.Text

  // Price / size (native currency)
  price             Float?
  priceChangePct1d  Float?
  marketCap         Float?
  marketCapUsd      Float? // marketCap converted at refresh-time FX rate — use this (not marketCap) for cross-market screener sort/filter
  fxRateToUsd       Float? // 1.0 for US tickers; THB->USD rate captured at refresh time for TH tickers
  sharesOutstanding Float?
  fiftyTwoWeekHigh  Float?
  fiftyTwoWeekLow   Float?
  beta              Float?

  // Raw absolute figures (avoid back-computing from ratios, which breaks when a ratio is null e.g. negative earnings)
  epsTtm            Float?
  bookValuePerShare Float?
  revenueTtm        Float?
  totalCash         Float?

  // Value
  peRatio    Float?
  forwardPe  Float?
  pbRatio    Float?
  psRatio    Float?
  evToEbitda Float?

  // Growth (analyst estimates) — sparse for TH tickers, see ScoreSnapshot "limited data" handling
  estEarningsGrowth Float?
  estRevenueGrowth  Float?

  // Analyst coverage
  analystTargetPrice Float?
  recommendationMean Float?
  numAnalystOpinions Int?

  // Profitability
  roe             Float?
  roa             Float?
  grossMargin     Float?
  operatingMargin Float?
  netMargin       Float?

  // Financial health
  debtToEquity     Float?
  currentRatio     Float?
  quickRatio       Float?
  interestCoverage Float?

  // Dividend (dividendYield is written as 0, not null, when the provider confirms "no dividend" — null is reserved for "unknown")
  dividendYield Float?
  payoutRatio   Float?

  // Ownership
  heldPercentInsiders     Float?
  heldPercentInstitutions Float?
  floatShares             Float?

  // Denormalized latest score (avoids a greatest-n-per-group query against ScoreSnapshot for the screener)
  latestOverallScore  Float?
  latestValueScore    Float?
  latestFutureScore   Float?
  latestPastScore     Float?
  latestHealthScore   Float?
  latestDividendScore Float?
  latestMomentumScore Float? // not part of the 5-petal Snowflake radar; used by the configurable-weight screener ranking
  latestScoreDate     DateTime?

  isActive      Boolean   @default(true)
  lastFetchedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  financialHistory FinancialHistory[]
  priceHistory     PriceHistory[]
  scoreSnapshots   ScoreSnapshot[]
  watchlistItems   WatchlistItem[]
  deepReports      DeepReport[]

  @@index([market])
  @@index([sector])
  @@index([isActive])
}

model FinancialHistory {
  id               String     @id @default(cuid())
  stockId          String
  stock            Stock      @relation(fields: [stockId], references: [id], onDelete: Cascade)
  period           String
  periodType       PeriodType
  fiscalDateEnding DateTime
  revenue          Float?
  netIncome        Float?
  eps              Float?
  freeCashFlow     Float?
  totalDebt        Float?
  totalEquity      Float?
  createdAt        DateTime   @default(now())

  @@unique([stockId, period, periodType])
}

// One row per stock per refresh day. Cheap (~250 rows/day) daily-close log — not full OHLC/intraday —
// captured as insurance for momentum scoring and future price-chart needs, since history can't be backfilled later.
model PriceHistory {
  id        String   @id @default(cuid())
  stockId   String
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  date      DateTime
  close     Float
  createdAt DateTime @default(now())

  @@unique([stockId, date])
  @@index([date])
}

model ScoreSnapshot {
  id             String   @id @default(cuid())
  stockId        String
  stock          Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  date           DateTime
  valueScore     Float?
  futureScore    Float?
  pastScore      Float?
  healthScore    Float?
  dividendScore  Float?
  momentumScore  Float? // price-based, from PriceHistory; not one of the 5 Snowflake petals
  overallScore   Float?
  // Per metric: { value, percentile }. Per dimension: { availableCount, totalCount } for "limited data" UI badges.
  rawMetricsJson Json?
  createdAt      DateTime @default(now())

  @@unique([stockId, date])
  @@index([date])
}

model WatchlistItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stockId     String
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  notes       String?
  targetPrice Float?
  createdAt   DateTime @default(now())

  @@unique([userId, stockId])
}

model RefreshLog {
  id               String        @id @default(cuid())
  startedAt        DateTime      @default(now())
  finishedAt       DateTime?
  status           RefreshStatus
  tickersProcessed Int           @default(0)
  tickersFailed    Int           @default(0)
  errorSummary     String?
}

// Personal notes synced in from a local Obsidian vault via a manually-run local script
// (the vault itself is never reachable from the deployed/cloud app). Feeds DeepReport generation.
model Note {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticker     String? // best-effort match to a Stock.ticker; nullable since not every note is stock-specific
  title      String
  content    String   @db.Text
  sourcePath String // original path within the vault, used to dedupe/update on re-sync
  syncedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, sourcePath])
  @@index([userId, ticker])
}

// AI-generated ("deep report") synthesis for one stock, combining cached fundamentals + the user's own Notes.
model DeepReport {
  id        String   @id @default(cuid())
  stockId   String
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  model     String // which Claude model generated this report
  createdAt DateTime @default(now())

  @@index([stockId, userId])
}

// ============================================================
//  Compound OS — multi-market research pipeline (Phase 0)
//  RawSource -> FinancialFact -> AnalysisOutput -> ResearchReport -> QualityGateLog -> KnowledgeNote
//
//  Renamed vs. the original plan to avoid collisions with the models above:
//    Market (source enum)      -> SourceMarket   (Stock.market's `Market` enum already means TH/US/HK)
//    DeepReport (report model) -> ResearchReport (DeepReport above is the existing simple AI-report feature)
// ============================================================

// ---------- 1. RawSource — pointer to an archived raw file on disk ----------
// insert-only: never update or delete. A changed filing gets a new row (new hash).

model RawSource {
  id           String   @id @default(cuid())
  ticker       String
  market       SourceMarket
  filePath     String // path on disk, not the file content
  sha256Hash   String   @unique // dedupes re-fetches + detects a changed source file
  sourceUrl    String?
  fiscalPeriod String?
  fetchedBy    String // 'sec.ts' | 'hkex.ts' | 'th.ts' | 'router.ts:archiveYahoo'
  fetchedAt    DateTime @default(now())

  facts        FinancialFact[]

  @@index([ticker, fetchedAt])
  @@index([market, ticker])
}

// ---------- 2. FinancialFact — one row = one number, traceable to its RawSource ----------

model FinancialFact {
  id          String    @id @default(cuid())
  rawSourceId String
  rawSource   RawSource @relation(fields: [rawSourceId], references: [id], onDelete: Restrict)

  ticker      String
  metricName  String // 'P/E' | 'ROE' | 'Revenue'
  value       Float
  unit        String // 'x' | '%' | 'currency' | 'count'
  period      String // '2025-12-31'
  statement   String? // 'BS' | 'IS' | 'CF'
  extractedBy String // 'YAHOO_FIELD_MAP' | 'extractor-agent'
  extractedAt DateTime  @default(now())

  @@unique([ticker, metricName, period, rawSourceId])
  @@index([ticker, metricName])
  @@index([ticker, period])
}

// ---------- 3. AnalysisOutput — one agent's output for one report section ----------

model AnalysisOutput {
  id          String     @id @default(cuid())
  ticker      String
  section     String // 'moat' | 'riskFactors' | 'verdict' ...
  content     Json // matches sectionSchemas[section] in lib/report/schema.ts
  generatedBy String
  modelTier   ModelTier
  gateStatus  GateStatus @default(PENDING)
  retryCount  Int        @default(0)
  createdAt   DateTime   @default(now())

  @@index([ticker, section, createdAt])
}

// ---------- 4. ResearchReport — the full compound-os report (StockReport payload) ----------

model ResearchReport {
  id           String       @id @default(cuid())
  ticker       String
  exchange     SourceMarket
  payload      Json // StockReport object (see lib/report/types.ts)
  decision     Decision
  conviction   Int
  dataAsOf     DateTime
  gateStatus   GateStatus   @default(PENDING)
  modelTier    ModelTier
  obsidianPath String?
  createdAt    DateTime     @default(now())

  gateLogs     QualityGateLog[]

  @@index([ticker, createdAt])
  @@index([decision, conviction])
  @@index([gateStatus])
}

// ---------- 5. QualityGateLog — one row per gate check on a ResearchReport ----------

model QualityGateLog {
  id         String         @id @default(cuid())
  reportId   String
  report     ResearchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  gateNumber Int // 1-6
  gateName   String // 'fact' | 'consistency' | ... | 'nena'
  passed     Boolean
  rigor      GateRigor // markets differ in how deep this gate can actually check
  notes      Json?
  reviewedBy String // 'gate1.ts' | 'nena-agent'
  reviewedAt DateTime       @default(now())

  @@index([reportId, gateNumber])
}

// ---------- 6. KnowledgeNote — pointer into the Obsidian vault (feedback loop) ----------

model KnowledgeNote {
  id             String   @id @default(cuid())
  ticker         String
  obsidianPath   String   @unique
  title          String
  tags           String[]
  linkedReportId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ticker])
}

// ---------- enums ----------

enum SourceMarket {
  SEC    // SEC EDGAR (US)
  HKEX   // HKEX filings (HK)
  TH_SEC // ก.ล.ต. (TH)
  SET    // SET factsheet (TH)
  YAHOO  // Yahoo Finance (all markets)
  NEWS
  MANUAL
}

enum ModelTier {
  TIER1_FABLE5
  TIER2_OPUS
  TIER3_SONNET
  NONE // pure code, no AI involved
}

enum GateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Decision {
  GO
  WAIT
  NO_GO
}

// How deep a gate can actually check — US has XBRL for a full check; HK/TH can only compare against Yahoo.
enum GateRigor {
  FULL    // checked against an official structured source (SEC XBRL)
  PARTIAL // checked against Yahoo only
  MANUAL  // needs a human
}
