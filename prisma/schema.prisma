// akeguru — Prisma schema
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Market {
  TH
  US
  HK
}

enum PeriodType {
  ANNUAL
  QUARTERLY
}

enum RefreshStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String          @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  createdAt      DateTime        @default(now())
  watchlistItems WatchlistItem[]
  notes          Note[]
  deepReports    DeepReport[]
}

model Stock {
  id       String  @id @default(cuid())
  ticker   String  @unique
  market   Market
  exchange String
  name     String
  sector   String?
  industry String?
  currency String? // defaulted from `market` at ingestion time (TH -> THB, US -> USD); should never be null in practice
  description String? @db.Text
  themes   String[] @default([]) // manually set (no Theme Agent yet) — rendered as [[Theme - X]] wikilinks in the Obsidian export

  // Price / size (native currency)
  price             Float?
  priceChangePct1d  Float?
  marketCap         Float?
  marketCapUsd      Float? // marketCap converted at refresh-time FX rate — use this (not marketCap) for cross-market screener sort/filter
  fxRateToUsd       Float? // 1.0 for US tickers; THB->USD rate captured at refresh time for TH tickers
  avgDailyValueUsd  Float? // 3-month avg daily volume x price x fxRateToUsd -- see lib/scoring.ts's liquidity modifier
  sharesOutstanding Float?
  fiftyTwoWeekHigh  Float?
  fiftyTwoWeekLow   Float?
  beta              Float?

  // Raw absolute figures (avoid back-computing from ratios, which breaks when a ratio is null e.g. negative earnings)
  epsTtm            Float?
  bookValuePerShare Float?
  revenueTtm        Float?
  totalCash         Float?

  // Value
  peRatio    Float?
  forwardPe  Float?
  pbRatio    Float?
  psRatio    Float?
  evToEbitda Float?

  // Growth (analyst estimates) — sparse for TH tickers, see ScoreSnapshot "limited data" handling
  estEarningsGrowth Float?
  estRevenueGrowth  Float?

  // Analyst coverage
  analystTargetPrice Float?
  recommendationMean Float?
  numAnalystOpinions Int?

  // Profitability
  roe             Float?
  roa             Float?
  grossMargin     Float?
  operatingMargin Float?
  netMargin       Float?

  // Financial health
  debtToEquity     Float?
  currentRatio     Float?
  quickRatio       Float?
  interestCoverage Float?

  // Dividend (dividendYield is written as 0, not null, when the provider confirms "no dividend" — null is reserved for "unknown")
  dividendYield Float?
  payoutRatio   Float?

  // Ownership
  heldPercentInsiders     Float?
  heldPercentInstitutions Float?
  floatShares             Float?

  // Denormalized latest score (avoids a greatest-n-per-group query against ScoreSnapshot for the screener)
  latestOverallScore  Float?
  latestValueScore    Float?
  latestFutureScore   Float?
  latestPastScore     Float?
  latestHealthScore   Float?
  latestDividendScore Float?
  latestMomentumScore Float? // not part of the 5-petal Snowflake radar; used by the configurable-weight screener ranking
  latestLiquidityTier String?   // 'high' | 'medium' | 'low' | 'illiquid' | null (unknown) -- see lib/scoring.ts; latestOverallScore already has this discount applied, this is just for display/filtering
  lynchCategory       String?   // 'fast_grower' | 'stalwart' | 'slow_grower' | 'cyclical' | null (unclassified -- see lib/lynch.ts)
  pegRatio            Float?    // Lynch PEG = P/E / (growth rate as a whole number) -- lib/lynch.ts's computePegRatio()
  latestScoreDate     DateTime?

  isActive      Boolean   @default(true)
  lastFetchedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  financialHistory FinancialHistory[]
  priceHistory     PriceHistory[]
  scoreSnapshots   ScoreSnapshot[]
  watchlistItems   WatchlistItem[]
  deepReports      DeepReport[]

  @@index([market])
  @@index([sector])
  @@index([isActive])
}

model FinancialHistory {
  id               String     @id @default(cuid())
  stockId          String
  stock            Stock      @relation(fields: [stockId], references: [id], onDelete: Cascade)
  period           String
  periodType       PeriodType
  fiscalDateEnding DateTime
  revenue          Float?
  netIncome        Float?
  eps              Float?
  freeCashFlow     Float?
  totalDebt        Float?
  totalEquity      Float?
  createdAt        DateTime   @default(now())

  @@unique([stockId, period, periodType])
}

// One row per stock per refresh day. Cheap (~250 rows/day) daily-close log — not full OHLC/intraday —
// captured as insurance for momentum scoring and future price-chart needs, since history can't be backfilled later.
model PriceHistory {
  id        String   @id @default(cuid())
  stockId   String
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  date      DateTime
  close     Float
  // Added for Turtle Trading (Donchian channels + ATR/"N" -- both need a real high/low, not just
  // close). Yahoo's chart() response already includes these on every row that populates `close` --
  // they just weren't captured before. Nullable because rows written before this existed only have
  // `close`; scripts/backfill-price-ohlc.ts fills them in for already-ingested history.
  high      Float?
  low       Float?
  createdAt DateTime @default(now())

  @@unique([stockId, date])
  @@index([date])
}

model ScoreSnapshot {
  id             String   @id @default(cuid())
  stockId        String
  stock          Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  date           DateTime
  valueScore     Float?
  futureScore    Float?
  pastScore      Float?
  healthScore    Float?
  dividendScore  Float?
  momentumScore  Float? // price-based, from PriceHistory; not one of the 5 Snowflake petals
  overallScore   Float? // already has the liquidity modifier applied (see lib/scoring.ts) -- liquidityTier below is the "why", not a separate un-applied score
  liquidityTier  String? // 'high' | 'medium' | 'low' | 'illiquid' | null (avgDailyValueUsd unknown)
  // Per metric: { value, percentile }. Per dimension: { availableCount, totalCount } for "limited data" UI badges.
  rawMetricsJson Json?
  createdAt      DateTime @default(now())

  @@unique([stockId, date])
  @@index([date])
}

// Phase 3 roadmap item ("Regime Detection") -- one row per market per refresh day. Market breadth
// (% of the tracked universe with a positive 3-month price return), not a macro-factor model --
// see lib/regime.ts's header comment for why (no index/macro data exists in this pipeline yet).
model MarketRegime {
  id             String   @id @default(cuid())
  market         Market
  date           DateTime
  breadthPct     Float
  avgReturn3m    Float
  classification String   // 'RISK_ON' | 'RISK_OFF' | 'MIXED' -- see lib/regime.ts
  cohortSize     Int
  createdAt      DateTime @default(now())

  @@unique([market, date])
  @@index([market, date])
}

model WatchlistItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stockId     String
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  notes       String?
  targetPrice Float?
  createdAt   DateTime @default(now())

  @@unique([userId, stockId])
}

model RefreshLog {
  id               String        @id @default(cuid())
  startedAt        DateTime      @default(now())
  finishedAt       DateTime?
  status           RefreshStatus
  tickersProcessed Int           @default(0)
  tickersFailed    Int           @default(0)
  errorSummary     String?
}

// Personal notes synced in from a local Obsidian vault via a manually-run local script
// (the vault itself is never reachable from the deployed/cloud app). Feeds DeepReport generation.
model Note {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticker     String? // best-effort match to a Stock.ticker; nullable since not every note is stock-specific
  title      String
  content    String   @db.Text
  sourcePath String // original path within the vault, used to dedupe/update on re-sync
  syncedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, sourcePath])
  @@index([userId, ticker])
}

// AI-generated ("deep report") synthesis for one stock, combining cached fundamentals + the user's own Notes.
model DeepReport {
  id        String   @id @default(cuid())
  stockId   String
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  model     String // which Claude model generated this report
  createdAt DateTime @default(now())

  @@index([stockId, userId])
}

// ============================================================
//  Compound OS — multi-market research pipeline (Phase 0)
//  RawSource -> FinancialFact -> AnalysisOutput -> ResearchReport -> QualityGateLog -> KnowledgeNote
//
//  Renamed vs. the original plan to avoid collisions with the models above:
//    Market (source enum)      -> SourceMarket   (Stock.market's `Market` enum already means TH/US/HK)
//    DeepReport (report model) -> ResearchReport (DeepReport above is the existing simple AI-report feature)
// ============================================================

// ---------- 1. RawSource — pointer to an archived raw file on disk ----------
// insert-only: never update or delete. A changed filing gets a new row (new hash).

model RawSource {
  id           String   @id @default(cuid())
  ticker       String
  market       SourceMarket
  filePath     String // path on disk, not the file content
  sha256Hash   String   @unique // dedupes re-fetches + detects a changed source file
  sourceUrl    String?
  fiscalPeriod String?
  fetchedBy    String // 'sec.ts' | 'hkex.ts' | 'th.ts' | 'router.ts:archiveYahoo'
  fetchedAt    DateTime @default(now())

  facts        FinancialFact[]

  @@index([ticker, fetchedAt])
  @@index([market, ticker])
}

// ---------- 2. FinancialFact — one row = one number, traceable to its RawSource ----------

model FinancialFact {
  id          String    @id @default(cuid())
  rawSourceId String
  rawSource   RawSource @relation(fields: [rawSourceId], references: [id], onDelete: Restrict)

  ticker      String
  metricName  String // 'P/E' | 'ROE' | 'Revenue'
  value       Float
  unit        String // 'x' | '%' | 'currency' | 'count'
  period      String // '2025-12-31'
  statement   String? // 'BS' | 'IS' | 'CF'
  // The exact upstream field/tag this value came from -- disambiguates two facts that share the
  // same human metricName but a different underlying definition (e.g. Yahoo's dotted field path
  // 'financialData.returnOnEquity', or 'us-gaap:EarningsPerShareDiluted (10-K)' for an SEC/XBRL
  // fact). Null where the metricName already *is* the raw definition with nothing to disambiguate.
  sourceDefinition String?
  // true = value is expressed in current (post-any-split) share/price terms (every Yahoo-sourced
  // per-share or share-count fact, since Yahoo always serves live/current data); false = an
  // as-filed historical per-share/share-count figure (SEC/XBRL) not verified against a later split;
  // null = not applicable -- the metric isn't share-count/per-share sensitive in the first place
  // (ratios, margins, totals), so the question doesn't arise.
  splitAdjusted Boolean?
  // A trust/quality annotation for when this value is known to need discounting somewhat, e.g.
  // 'low-coverage' (fewer than MIN_ANALYSTS_FOR_COVERAGE analysts behind a consensus estimate --
  // see lib/report/estimates.ts). Free text, not an enum: the set of frictions worth flagging will
  // grow as more get discovered live (same reasoning as BulletGroundingIssue.reason's string
  // literal union, kept loose rather than pre-designing every case up front). Null = none known.
  dataFriction String?
  extractedBy String // 'YAHOO_FIELD_MAP' | 'extractor-agent'
  extractedAt DateTime  @default(now())

  @@unique([ticker, metricName, period, rawSourceId])
  @@index([ticker, metricName])
  @@index([ticker, period])
}

// ---------- 3. AnalysisOutput — one agent's output for one report section ----------

model AnalysisOutput {
  id          String     @id @default(cuid())
  ticker      String
  section     String // 'moat' | 'riskFactors' | 'verdict' ...
  content     Json // matches sectionSchemas[section] in lib/report/schema.ts
  generatedBy String
  modelTier   ModelTier
  gateStatus  GateStatus @default(PENDING)
  retryCount  Int        @default(0)
  createdAt   DateTime   @default(now())

  @@index([ticker, section, createdAt])
}

// ---------- 4. ResearchReport — the full compound-os report (StockReport payload) ----------

model ResearchReport {
  id           String       @id @default(cuid())
  ticker       String
  exchange     SourceMarket
  payload      Json // StockReport object (see lib/report/types.ts)
  decision     Decision
  conviction   Int
  dataAsOf     DateTime
  gateStatus   GateStatus   @default(PENDING)
  modelTier    ModelTier
  obsidianPath String?
  createdAt    DateTime     @default(now())

  gateLogs     QualityGateLog[]

  @@index([ticker, createdAt])
  @@index([decision, conviction])
  @@index([gateStatus])
}

// ---------- 5. QualityGateLog — one row per gate check on a ResearchReport ----------

model QualityGateLog {
  id         String         @id @default(cuid())
  reportId   String
  report     ResearchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  gateNumber Int // 1-6
  gateName   String // 'fact' | 'consistency' | ... | 'nena'
  passed     Boolean
  rigor      GateRigor // markets differ in how deep this gate can actually check
  notes      Json?
  reviewedBy String // 'gate1.ts' | 'nena-agent'
  reviewedAt DateTime       @default(now())

  @@index([reportId, gateNumber])
}

// ---------- 6. KnowledgeNote — pointer into the Obsidian vault (feedback loop) ----------

model KnowledgeNote {
  id             String   @id @default(cuid())
  ticker         String
  obsidianPath   String   @unique
  title          String
  tags           String[]
  linkedReportId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ticker])
}

// ---------- enums ----------

enum SourceMarket {
  SEC    // SEC EDGAR (US)
  HKEX   // HKEX filings (HK)
  TH_SEC // ก.ล.ต. (TH)
  SET    // SET factsheet (TH)
  YAHOO  // Yahoo Finance (all markets)
  NEWS
  MANUAL
}

enum ModelTier {
  TIER1_FABLE5
  TIER2_OPUS
  TIER3_SONNET
  NONE // pure code, no AI involved
}

enum GateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Decision {
  GO
  WAIT
  NO_GO
}

// How deep a gate can actually check — US has XBRL for a full check; HK/TH can only compare against Yahoo.
enum GateRigor {
  FULL    // checked against an official structured source (SEC XBRL)
  PARTIAL // checked against Yahoo only
  MANUAL  // needs a human
}

enum RelationType {
  SUPPLIER    // relatedTicker supplies inputs/components to ticker
  CUSTOMER    // relatedTicker is a customer of ticker (buys from it)
  COMPETITOR  // relatedTicker competes with ticker for the same demand
  BENEFICIARY // relatedTicker benefits from ticker's business/spending without being a direct supplier/customer (e.g. a capex beneficiary)
}

// Phase 2 roadmap item ("CompanyRelation table") -- manually entered for now (see
// scripts/add-company-relation.ts), same reasoning as Stock.themes: no agent exists yet to infer
// these from business descriptions, and a wrong inferred relation silently feeding a future
// Read-Across Engine (Phase 4 -- "fact changes -> rerun related tickers") would be worse than no
// relation at all. One directed row per relationship fact -- ticker's perspective, relatedTicker is
// the SUPPLIER/CUSTOMER/COMPETITOR/BENEFICIARY. A reciprocal relationship (e.g. two competitors)
// needs its own row in the other direction if you want it queryable from both sides; nothing here
// auto-derives the inverse.
model CompanyRelation {
  id            String       @id @default(cuid())
  ticker        String
  relatedTicker String
  relationType  RelationType
  notes         String?      @db.Text
  createdAt     DateTime     @default(now())

  @@unique([ticker, relatedTicker, relationType])
  @@index([ticker])
  @@index([relatedTicker])
}

enum SentimentLabel {
  BULL
  NEUTRAL
  BEAR
}

enum AuthorSegment {
  RETAIL
  GURU
  BOT
  UNKNOWN
}

// Xueqiu Layer 8 (Phase 3 roadmap item) -- this app's own LLM sentiment classification + author
// segmentation for a post, keyed to a ticker this app tracks. Raw post collection/dedup/stock-
// linking is owned by Codex, a separate local pipeline (D:\Secondbrain\SocialMedia\database\
// socialmedia.db, SQLite) -- scripts/sync-social-sentiment.ts reads posts from there already
// linked to a tracked ticker, this table only holds the analysis this app runs on top.
model SocialSentiment {
  id             String        @id @default(cuid())
  ticker         String
  sourcePlatform String        // Codex's sources.name, e.g. 'Reddit' | 'Xueqiu' -- free text, that pipeline owns the vocabulary
  externalPostId String        // Codex posts.id (SQLite integer, as string) -- dedup key alongside sourcePlatform
  author         String?
  publishedAt    DateTime?
  contentExcerpt String        @db.Text // trimmed post content, for traceability/review -- Codex's SQLite is the source of truth for the full post

  sentiment      SentimentLabel
  sentimentScore Float          // -1..1
  authorSegment  AuthorSegment
  confidence     Float          // 0..1
  modelName      String
  reasoning      String         @db.Text

  analyzedAt     DateTime      @default(now())

  @@unique([sourcePlatform, externalPostId])
  @@index([ticker])
  @@index([sentiment])
}

// Home page "Market Context" strip -- a handful of real index/commodity/FX quotes (S&P/Nasdaq
// futures, SET, HSI, Gold, USD/THB), fetched via the same yahooFinance client lib/yahoo.ts already
// uses (yahoo-finance2's quote() on ^SET.BK/^HSI/ES=F/NQ=F/GC=F/THB=X-style symbols). One row per
// symbol, upserted on each refresh -- not a time series (PriceHistory already covers per-stock
// history; this is just "what's the market doing right now" for display, not analysis input).
model MarketQuote {
  id            String   @id @default(cuid())
  symbol        String   @unique // the Yahoo symbol, e.g. 'ES=F', '^SET.BK'
  label         String   // display name, e.g. 'S&P Futures'
  price         Float
  changePct     Float    // regularMarketChangePercent, already a percent (e.g. -0.14 = -0.14%)
  fetchedAt     DateTime @default(now())
}

// CCASS shareholding concentration (lib/data/input-sources/ccass.ts, scripts/fetch-ccass.ts) --
// HK-only, real ownership data scraped from hkexnews.hk. Not short interest -- HKEX/CCASS doesn't
// publish short positions (that's a separate SFC disclosure regime, not covered here). One row
// per (ticker, asOfDate) rather than a row per CCASS participant (~130/ticker/day, mostly static
// broker addresses) -- topHolders carries the top 10 as scraped for direct display.
model CcassSnapshot {
  id                String   @id @default(cuid())
  ticker            String
  asOfDate          DateTime
  totalShareholding Float // total shares held within CCASS
  totalParticipants Int
  totalPctOfIssued  Float // % of issued shares/warrants/units held in CCASS at all
  totalIssuedShares Float
  top1PctOfIssued   Float? // largest single participant's % of issued shares
  top10PctOfIssued  Float? // sum of top-10 participants' % of issued shares -- concentration signal
  topHolders        Json // CcassHolder[] (top 10), real participant id/name/address/shareholding/pct
  fetchedAt         DateTime @default(now())

  @@unique([ticker, asOfDate])
  @@index([ticker])
}

// Macro-regime sector rotation (lib/rotation.ts, scripts/fetch-rotation-signal.ts) -- a
// deliberately small slice of a much larger research vision (see lib/rotation.ts's header). One
// row per run: a rules-based best-guess ExitCause (nullable -- null is a real, honest "couldn't
// classify confidently," not a missing value) from real signals (yield curve, VIX, defensive-vs-
// cyclical sector performance), plus the matching ROTATION_MAP phase sectors for direct display.
model RotationSignal {
  id            String   @id @default(cuid())
  asOf          DateTime
  exitCause     String? // ExitCause | null -- see lib/rotation.ts's ExitCause type
  confidence    String // 'low' | 'medium'
  reasoning     String   @db.Text
  phase1Sectors String[]
  phase2Sectors String[]
  evidence      Json // RealRotationSignals -- the real yieldCurveSpread/vix/defensiveVsCyclical3m values

  @@index([asOf])
}
